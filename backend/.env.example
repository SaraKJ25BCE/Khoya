# Khoya Backend Environment Variables

# Service Port (Render sets $PORT automatically, defaults to 8000 for local dev)
PORT=8000

# CORS Allowed Origins (Comma-separated URLs, or * for open access)
# In production on Render, set this to your frontend URL:
ALLOWED_ORIGINS=https://khoya-frontend.onrender.com,http://localhost:5173

# Application Environment (development / production)
ENVIRONMENT=production

# Python version for Render build environment
PYTHON_VERSION=3.11.0

# -----------------------------------------------------------------------------
# Deferred Scope (Hour 12-24 / FR7-FR8) - Stubs for future features:
# -----------------------------------------------------------------------------
# DATABASE_URL=postgresql://user:password@localhost:5432/khoya_db
# REDIS_URL=redis://localhost:6379/0
