# Khoya Backend Environment Variables

# Service Port (Render sets $PORT automatically, defaults to 8000 for local dev)
PORT=8000

# Application Environment (development / production)
ENVIRONMENT=production

# Python version for Render build environment
PYTHON_VERSION=3.11.0

# -----------------------------------------------------------------------------
# CORS & URLs
# -----------------------------------------------------------------------------
# CORS Allowed Origins (Comma-separated URLs)
ALLOWED_ORIGINS=https://khoya-one.vercel.app,http://localhost:5173,http://localhost:3000

# Frontend Application URL (used by Google OAuth callback to redirect user back)
FRONTEND_URL=https://khoya-one.vercel.app

# -----------------------------------------------------------------------------
# Google OAuth Configuration
# -----------------------------------------------------------------------------
# Create OAuth 2.0 Client ID in Google Cloud Console (https://console.cloud.google.com/)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=https://khoya-nnva.onrender.com/auth/google/callback

# Session Secret (used to sign express session cookies)
SESSION_SECRET=your_session_secret_here

# -----------------------------------------------------------------------------
# Database Configuration (PostgreSQL / Supabase)
# -----------------------------------------------------------------------------
# PostgreSQL connection string for user persistence & trades schema
DATABASE_URL=postgresql://user:password@localhost:5432/khoya_db

# -----------------------------------------------------------------------------
# Zerodha (Kite Connect) API Credentials
# -----------------------------------------------------------------------------
KITE_API_KEY=your_zerodha_api_key
KITE_API_SECRET=your_zerodha_api_secret
KITE_ACCESS_TOKEN=your_zerodha_access_token

# -----------------------------------------------------------------------------
# Deferred Scope (Hour 12-24 / FR7-FR8) - Stubs for future features:
# -----------------------------------------------------------------------------
# REDIS_URL=redis://localhost:6379/0
