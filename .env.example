# Khoya Root Environment Example
# Copy relevant environment variables to backend/.env and frontend/.env or set them in Render Dashboard.

# =============================================================================
# Backend Configuration (backend/.env)
# =============================================================================
PORT=8000
ALLOWED_ORIGINS=https://khoya-frontend.onrender.com,http://localhost:5173
ENVIRONMENT=production
PYTHON_VERSION=3.11.0

# =============================================================================
# Frontend Configuration (frontend/.env)
# =============================================================================
VITE_API_BASE_URL=https://khoya-backend.onrender.com
